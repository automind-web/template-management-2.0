{
  "name": "ai-management",
  "displayName": "AI Management",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build && node scripts/check-artifact.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "node scripts/migrate-local.mjs",
    "db:check": "node --experimental-sqlite scripts/check-migrations.mjs",
    "test": "node --experimental-sqlite --experimental-strip-types --test test/*.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "db:reset:local": "node scripts/reset-local.mjs"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.79.0",
    "next": "16.4.6",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.68.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitejs/plugin-rsc": "0.5.39",
    "drizzle-kit": "0.31.11",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vinext": "1.4.4",
    "vite": "8.3.7",
    "wrangler": "4.160.0"
  }
}
